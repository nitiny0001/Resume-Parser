{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "worker.Dockerfile"
  },
  "deploy": {
    "startCommand": "arq app.workers.resume_worker.WorkerSettings",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 5
  }
}
